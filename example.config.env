# ============================================================================
# pds-sync configuration — TEMPLATE
#
# Copy to your real config (install.sh does this for you) and fill in the
# two REQUIRED values (DOCKHAND_ENV_NAME + PORTAINER_API_KEY):
#
#     cp example.config.env config.env
#
# The running service reads $PDS_CONFIG (default /etc/pds/config.env). This file
# is intentionally git-ignored (config.env) so real keys are never committed.
# ============================================================================

# --- Portainer (REST API) ---------------------------------------------------
# Base URL of the Portainer you sync against (a local instance on the host):
PORTAINER_URL=https://127.0.0.1:9000

# REQUIRED. Portainer UI -> Settings -> API Keys -> Add API Key (no expiry).
# NOTE: this Portainer build authenticates via the X-API-Key header (sync.py
# sends that automatically) — NOT the X-Http-Auth-Token header in older docs.
PORTAINER_API_KEY=

# Fallback Docker endpoint id. sync.py AUTO-DETECTS it from GET /api/endpoints,
# so leave this as-is unless detection fails for some reason.
PORTAINER_ENDPOINT_ID=1

# --- Dockhand ----------------------------------------------------------------
# REQUIRED. The Dockhand *environment* name (must match EXACTLY, spaces
# included). Find it in the Dockhand UI or its volume path:
#   dockhand:/app/data/stacks/<THIS NAME>/<stack>/
DOCKHAND_ENV_NAME=My Environment

# --- shared data root (relative-path canonicalization) -----------------------
# Relative bind paths in a compose file are rewritten to
#   <PDS_DATA_ROOT>/<stackname>/...
# so Portainer and Dockhand bind to the SAME on-disk data.
PDS_DATA_ROOT=/data/compose

# --- behavior ----------------------------------------------------------------
# Seconds between store scans.
POLL_INTERVAL=20
# Seconds between full store re-canonicalization (drift self-heal).
DEEP_INTERVAL=300

# Comma-separated stack names the sync must NEVER touch. Leave empty unless a
# particular stack is managed out-of-band and would break on a full redeploy
# (e.g. a stack whose database was upgraded standalone).
EXCLUDE_STACKS=

# 1 = converge containers on sync (default). 0 = mirror files + registration
# only, without touching running containers.
DEPLOY_ON_SYNC=1

# 1 = DRY_RUN (log intended actions without writing anything) — for testing.
DRY_RUN=0

# --- ownership for migrated data dirs ----------------------------------------
# The uid:gid the service runs as (id -u / id -g) — used when it moves data.
DEFAULT_UID=1000
DEFAULT_GID=1000

# --- watchdog ----------------------------------------------------------------
# Seconds before the health timer considers the service stale and restarts it.
HEALTH_LIVENESS_SECS=120
